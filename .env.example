# PostgreSQL (required for register/login and task persistence)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honeypush

# Optional: Eazo platform integration (auth / share / notifications in Eazo app)
# EAZO_PRIVATE_KEY=
# EAZO_APP_ID=

# LLM for AI task parsing & scheduling (OpenAI-compatible HTTP API)
# Providers: OpenAI, DeepSeek, Moonshot, Groq, Azure OpenAI, etc.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# Aliases also supported: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
