# Copy to .env.production on your Aliyun ECS, then:
#   npm run deploy:prod
# or:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# PostgreSQL container password (required)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# App connection string — password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://postgres:change-me-to-a-long-random-password@postgres:5432/honeypush

# Public URL of your site (used for Open Graph metadata)
# Example: http://47.xxx.xxx.xxx:3000 or https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://YOUR_ECS_PUBLIC_IP:3000

# Optional: AI task parsing & scheduling
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Optional: daily digest cron (call from ECS crontab)
# CRON_SECRET=
